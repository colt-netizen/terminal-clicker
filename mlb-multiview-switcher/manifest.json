{
  "manifest_version": 3,
  "name": "MLB Multiview Audio Switcher",
  "version": "0.4.0",
  "description": "Keeps MLB.tv multiview audio on live baseball: tracks every game's state, follows your team priorities, and swaps dead panes for live games.",
  "permissions": [
    "storage",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.mlb.com/*",
    "https://statsapi.mlb.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mlb.com/*"
      ],
      "js": [
        "src/shared/silence-machine.js",
        "src/shared/pane-selector.js",
        "src/shared/settings.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "MLB Multiview Audio Switcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
